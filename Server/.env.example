# Database (local dev — production uses DATABASE_URL from Render)
DB_PASSWORD=your-postgres-password

# Application
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:3000

# Production (comma-separated, no spaces)
# ALLOWED_HOSTS=studybuddy-api.onrender.com,.onrender.com
# CORS_ALLOWED_ORIGINS=https://sajidha-huzair.github.io
# CSRF_TRUSTED_ORIGINS=https://sajidha-huzair.github.io
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# REDIS_URL=redis://...

# Google Sign-In (optional)
GOOGLE_CLIENT_ID=

# Video — Daily.co (optional; falls back to Jitsi without a key)
DAILY_API_KEY=
DAILY_WEBHOOK_SECRET=
JITSI_DOMAIN=meet.jit.si
