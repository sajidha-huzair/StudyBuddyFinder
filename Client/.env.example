# API Configuration
VITE_API_URL=http://127.0.0.1:8000/api

# GitHub Pages: /StudyBuddyFinder/  |  Custom domain or local dev: /
VITE_BASE_PATH=/

# Environment
VITE_ENV=development

# WebSocket uses the same host as VITE_API_URL (ws://127.0.0.1:8000/ws/chat/)

# Google Sign-In (optional) — create at https://console.cloud.google.com/
# Authorized JavaScript origins: http://localhost:3000
VITE_GOOGLE_CLIENT_ID=
